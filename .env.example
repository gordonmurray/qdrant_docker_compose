# Copy to .env (or run `make init`, which generates keys for you).
QDRANT_VERSION=v1.20.0
QDRANT_LOG_LEVEL=INFO

# Full-access key and read-only key. `make init` fills these with random values.
QDRANT_API_KEY=
QDRANT_READ_ONLY_API_KEY=

# Defaults for NEW collections only.
QDRANT_DEFAULT_REPLICATION_FACTOR=3
QDRANT_DEFAULT_WRITE_CONSISTENCY_FACTOR=2

# Per-node limits.
QDRANT_MEM_LIMIT=2g
QDRANT_CPUS=2

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=7d

# Host ports (change them to run a second copy side by side, and set a different
# COMPOSE_PROJECT_NAME).
# COMPOSE_PROJECT_NAME=qdrant
# QDRANT_REST_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_NODE_PORT_1=7001
# QDRANT_NODE_PORT_2=7002
# QDRANT_NODE_PORT_3=7003
# HAPROXY_STATS_PORT=8404
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# Optional: node/host metrics (see compose.yaml).
# COMPOSE_PROFILES=host-metrics
